# ══ Server ══
PORT=3000

# ══ JWT ══
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRY=24h

# ══ Admin credentials (used to seed the first admin user) ══
ADMIN_EMAIL=admin@therosaliabcn.com
ADMIN_PASSWORD=replace_with_a_strong_password

# ══ Database ══
DB_PATH=./db/rosalia.db
